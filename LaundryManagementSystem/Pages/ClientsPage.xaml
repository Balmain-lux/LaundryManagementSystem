<Page x:Class="LaundryManagementSystem.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientsPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="База клиентов" 
                   FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button x:Name="AddClient" Content="➕ Добавить клиента" Click="AddClient_Click"
                    Padding="15,8" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="EditClient" Content="✏️ Редактировать" Click="EditClient_Click"
                    Padding="15,8" Background="#17a2b8" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            <Button x:Name="DeleteClient" Content="🗑️ Удалить" Click="DeleteClient_Click"
                    Padding="15,8" Background="#dc3545" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            <Button x:Name="Refresh" Content="🔄 Обновить" Click="Refresh_Click"
                    Padding="15,8" Background="#6c757d" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            <Button x:Name="GoToMainPage" Content="🏠 На главную" Click="GoToMainPage_Click"
                    Padding="15,8" Background="#6f42c1" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Список клиентов -->
        <DataGrid Grid.Row="1" x:Name="dgClients" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="dgClients_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Бонусы" Binding="{Binding BonusPoints}" Width="80"/>
                <DataGridTextColumn Header="Дата регистрации" 
                                    Binding="{Binding RegistrationDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                    Width="110"/>
                <DataGridTextColumn Header="Кол-во заказов" Binding="{Binding OrdersCount}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
