<Page x:Class="LaundryManagementSystem.Pages.EditMaterialPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditMaterialPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding PageTitle}" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Название материала:" FontWeight="Bold"/>
        <TextBox Grid.Row="1" x:Name="txtMaterialName" Height="35" Margin="0,25,0,15" 
                 Padding="10" FontSize="14" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="2" Text="Единица измерения:" FontWeight="Bold"/>
        <ComboBox Grid.Row="2" x:Name="cmbUnit" Height="35" Margin="0,25,0,15"
                  Padding="10" FontSize="14" Background="#F5F5F5" BorderBrush="#CCCCCC">
            <ComboBoxItem Content="кг" IsSelected="True"/>
            <ComboBoxItem Content="л"/>
            <ComboBoxItem Content="шт"/>
            <ComboBoxItem Content="упак"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Текущий остаток:" FontWeight="Bold"/>
        <TextBox Grid.Row="3" x:Name="txtCurrentStock" Height="35" Margin="0,25,0,15" 
                 Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="4" Text="Минимальный запас:" FontWeight="Bold"/>
        <TextBox Grid.Row="4" x:Name="txtMinStock" Height="35" Margin="0,25,0,15" 
                 Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="5" Text="Цена за единицу:" FontWeight="Bold"/>
        <TextBox Grid.Row="5" x:Name="txtUnitPrice" Height="35" Margin="0,25,0,20" 
                 Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

        <TextBlock Grid.Row="6" x:Name="txtMessage" Foreground="Green" 
                   TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"
                   TextAlignment="Center" FontSize="12" FontWeight="Bold"/>

        <TextBlock Grid.Row="6" x:Name="txtError" Foreground="Red" 
                   TextWrapping="Wrap" Margin="0,15,0,0" HorizontalAlignment="Center"
                   TextAlignment="Center" FontSize="12"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveMaterial" Content="💾 Сохранить" Click="SaveMaterial_Click"
                    Padding="20,10" Margin="5" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="Cancel" Content="❌ Отмена" Click="Cancel_Click"
                    Padding="20,10" Margin="5" Background="#dc3545" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>
