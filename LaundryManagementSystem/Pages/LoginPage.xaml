<Page x:Class="LaundryManagementSystem.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Background="LightBlue">
        <Border Background="White" CornerRadius="10" Padding="30" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="500" Height="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Система управления химчисткой" 
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" 
                           Margin="0,0,0,20" Foreground="#0078D4"/>

                <TextBlock Grid.Row="1" Text="Логин:" FontWeight="Bold"/>
                <TextBox Grid.Row="1" x:Name="txtLogin" Height="35" Margin="0,25,0,15" 
                         Padding="10" FontSize="14" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

                <TextBlock Grid.Row="2" Text="Пароль:" FontWeight="Bold"/>
                <PasswordBox Grid.Row="2" x:Name="txtPassword" Height="35" Margin="0,25,0,20" 
                             Padding="10" FontSize="14" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

                <Button x:Name="LoginButton" Grid.Row="3" Content="Войти" Click="LoginButton_Click"
                        Height="40" Background="#0078D4" Foreground="White" 
                        FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>

                <TextBlock Grid.Row="4" x:Name="txtError" Foreground="Red" 
                           TextWrapping="Wrap" Margin="0,15,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" FontSize="12"/>

                <TextBlock Grid.Row="5" Text="Нет аккаунта?" 
                           HorizontalAlignment="Center" Margin="0,20,0,10"
                           Foreground="Gray" FontSize="12"/>

                <Button x:Name="RegisterButton" Grid.Row="6" Content="Зарегистрироваться" Click="RegisterButton_Click" 
                        Height="35" Background="Transparent" Foreground="#0078D4" 
                        FontWeight="Bold" FontSize="12" BorderBrush="#0078D4" BorderThickness="1"
                        Cursor="Hand" Padding="20,5"/>
            </Grid>
        </Border>
    </Grid>
</Page>
