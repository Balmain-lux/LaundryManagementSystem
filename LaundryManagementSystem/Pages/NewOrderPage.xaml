<Page x:Class="LaundryManagementSystem.Pages.NewOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewOrderPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создание нового заказа" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Клиент:" FontWeight="Bold"/>
        <ComboBox Grid.Row="1" x:Name="cmbClients" DisplayMemberPath="FullName" 
                  Margin="0,25,0,15" Height="35" Padding="5"/>

        <TextBlock Grid.Row="2" Text="Услуга:" FontWeight="Bold"/>
        <ComboBox Grid.Row="2" x:Name="cmbServices" DisplayMemberPath="ServiceName" 
                  Margin="0,25,0,15" Height="35" Padding="5" SelectionChanged="cmbServices_SelectionChanged"/>

        <TextBlock Grid.Row="3" Text="Тип ткани:" FontWeight="Bold"/>
        <ComboBox Grid.Row="3" x:Name="cmbFabrics" DisplayMemberPath="FabricName" 
                  Margin="0,25,0,15" Height="35" Padding="5" SelectionChanged="cmbFabrics_SelectionChanged"/>

        <CheckBox Grid.Row="4" x:Name="chkUrgent" Content="Срочный заказ (+30%)" 
                  Margin="0,10" Checked="chkUrgent_Checked" Unchecked="chkUrgent_Checked"
                  FontWeight="Bold" Foreground="Red"/>

        <TextBlock Grid.Row="5" Text="Стоимость:" FontWeight="Bold" FontSize="14"/>
        <TextBlock Grid.Row="5" x:Name="txtPrice" FontSize="18" FontWeight="Bold" 
                   Foreground="Green" Margin="0,25,0,20" HorizontalAlignment="Right" Width="150"/>

        <TextBlock Grid.Row="6" Text="Примечания:" FontWeight="Bold"/>
        <TextBox Grid.Row="6" x:Name="txtNotes" Margin="0,25,0,20" Height="80" 
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="5"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveOrder" Content="💾 Сохранить" Click="SaveOrder_Click" 
                    Padding="20,10" Margin="5" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="Cancel" Content="❌ Отмена" Click="Cancel_Click"
                    Padding="20,10" Margin="5" Background="#dc3545" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>
