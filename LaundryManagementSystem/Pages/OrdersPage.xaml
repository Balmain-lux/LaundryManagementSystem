<Page x:Class="LaundryManagementSystem.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="NewOrder" Content="➕ Новый заказ" Click="NewOrder_Click"
                    Padding="15,8" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="Refresh" Content="🔄 Обновить" Click="Refresh_Click" 
                    Padding="15,8" Background="#17a2b8" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Список заказов -->
        <DataGrid Grid.Row="1" x:Name="dgOrders" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="dgOrders_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderID}" Width="60"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Clients.FullName}" Width="180"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Services.ServiceName}" Width="120"/>
                <DataGridTextColumn Header="Ткань" Binding="{Binding FabricTypes.FabricName}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding OrderStatuses.StatusName}" Width="90"/>
                <DataGridCheckBoxColumn Header="Срочный" Binding="{Binding Urgent}" Width="70"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalPrice, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreateDate, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
