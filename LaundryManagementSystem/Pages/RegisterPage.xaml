<Page x:Class="LaundryManagementSystem.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1000"
      Title="RegisterPage">

    <Grid Background="LightGreen">
        <Border Background="White" CornerRadius="10" Padding="30" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="500" Height="700">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Регистрация нового пользователя" 
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" 
                           Margin="0,0,0,20" Foreground="#28a745"/>

                <TextBlock Grid.Row="1" Text="ФИО:" FontWeight="Bold"/>
                <TextBox Grid.Row="1" x:Name="txtFullName" Height="35" Margin="0,25,0,15" 
                         Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

                <TextBlock Grid.Row="2" Text="Логин (телефон):" FontWeight="Bold"/>
                <TextBox Grid.Row="2" x:Name="txtUsername" Height="35" Margin="0,25,0,15" 
                         Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"
                         ToolTip="Логином будет ваш номер телефона"/>

                <TextBlock Grid.Row="3" Text="Пароль:" FontWeight="Bold"/>
                <PasswordBox Grid.Row="3" x:Name="txtPassword" Height="35" Margin="0,25,0,15" 
                             Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

                <TextBlock Grid.Row="4" Text="Подтверждение пароля:" FontWeight="Bold"/>
                <PasswordBox Grid.Row="4" x:Name="txtConfirmPassword" Height="35" Margin="0,25,0,15" 
                             Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"/>

                <TextBlock Grid.Row="5" Text="Роль:" FontWeight="Bold"/>
                <ComboBox Grid.Row="5" x:Name="cmbRole" Height="35" Margin="0,25,0,20"
                          Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC">
                    <ComboBoxItem Content="User" IsSelected="True" ToolTip="Обычный пользователь (клиент)"/>
                    <ComboBoxItem Content="Receptionist" ToolTip="Приемщик заказов"/>
                    <ComboBoxItem Content="Admin" ToolTip="Администратор системы"/>
                </ComboBox>

                <TextBlock Grid.Row="6" x:Name="txtMessage" Foreground="Green" 
                           TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" FontSize="12" FontWeight="Bold"/>

                <TextBlock Grid.Row="7" x:Name="txtError" Foreground="Red" 
                           TextWrapping="Wrap" Margin="0,15,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" FontSize="12"/>

                <Button x:Name="RegisterButton" Grid.Row="8" Content="Зарегистрироваться" Click="RegisterButton_Click" 
                        Height="40" Background="Blue" Foreground="White" 
                        FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"
                        Margin="0,0,0,10"/>

                <Button x:Name="BackToLogin" Grid.Row="9" Content="Назад к входу" Click="BackToLogin_Click"
                        Height="35" Background="Transparent" Foreground="#6c757d" 
                        FontSize="12" BorderBrush="#6c757d" BorderThickness="1"
                        Cursor="Hand" Padding="20,5"/>
            </Grid>
        </Border>
    </Grid>
</Page>
