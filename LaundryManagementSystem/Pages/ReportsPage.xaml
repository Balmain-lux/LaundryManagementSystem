<Page x:Class="LaundryManagementSystem.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportsPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Отчетность системы" 
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text=" (Только для администратора)" 
                       Foreground="Red" FontWeight="Bold" 
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопки отчетов -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="ShowIncomeReport" Content="💰 Доходы по месяцам" Click="ShowIncomeReport_Click"
                    Padding="15,8" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="ShowPopularServices" Content="📈 Популярные услуги" Click="ShowPopularServices_Click"
                    Padding="15,8" Background="#17a2b8" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            <Button x:Name="ShowPerformanceReport" Content="⏱️ Время выполнения" Click="ShowPerformanceReport_Click" 
                    Padding="15,8" Background="#ffc107" Foreground="Black" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            <Button x:Name="ShowActiveClients" Content="👥 Активные клиенты" Click="ShowActiveClients_Click"
                    Padding="15,8" Background="#6f42c1" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Результаты отчетов -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" 
                Background="#F8F9FA" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtReportResults" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
        </Border>
    </Grid>

</Page>
