<Page x:Class="LaundryManagementSystem.Pages.UserNewOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserNewOrderPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создание нового заказа" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Информация о клиенте:" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" x:Name="txtClientInfo" FontSize="12" Foreground="Blue" 
                   Margin="0,25,0,15" HorizontalAlignment="Right" Width="300" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Услуга:" FontWeight="Bold"/>
        <ComboBox Grid.Row="2" x:Name="cmbServices" DisplayMemberPath="ServiceName" 
                  Margin="0,25,0,15" Height="35" Padding="5" SelectionChanged="cmbServices_SelectionChanged"/>

        <TextBlock Grid.Row="3" Text="Описание услуги:" FontWeight="Bold" FontSize="11"/>
        <TextBlock Grid.Row="3" x:Name="txtServiceDescription" FontSize="11" Foreground="Gray" 
                   Margin="0,25,0,15" HorizontalAlignment="Right" Width="300" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="4" Text="Тип ткани:" FontWeight="Bold"/>
        <ComboBox Grid.Row="4" x:Name="cmbFabrics" DisplayMemberPath="FabricName" 
                  Margin="0,25,0,15" Height="35" Padding="5" SelectionChanged="cmbFabrics_SelectionChanged"/>

        <TextBlock Grid.Row="5" Text="Описание ткани:" FontWeight="Bold" FontSize="11"/>
        <TextBlock Grid.Row="5" x:Name="txtFabricDescription" FontSize="11" Foreground="Gray" 
                   Margin="0,25,0,15" HorizontalAlignment="Right" Width="300" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6" Text="Описание предмета одежды:" FontWeight="Bold"/>
        <TextBox Grid.Row="6" x:Name="txtItemDescription" Height="60" Margin="0,25,0,15" 
                 Padding="10" FontSize="11" Background="#F5F5F5" BorderBrush="#CCCCCC"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 ToolTip="Опишите, что вы хотите сдать в химчистку (например: 'Костюм темно-синий, пиджак и брюки')"/>

        <CheckBox Grid.Row="7" x:Name="chkUrgent" Content="Срочный заказ (+30%)" 
                  Margin="0,10" Checked="chkUrgent_Checked"  Unchecked="chkUrgent_Checked"
                  FontWeight="Bold" Foreground="Red"/>

        <TextBlock Grid.Row="8" Text="Стоимость:" FontWeight="Bold" FontSize="14"/>
        <TextBlock Grid.Row="8" x:Name="txtPrice" FontSize="18" FontWeight="Bold" 
                   Foreground="Green" Margin="0,25,0,20" HorizontalAlignment="Right" Width="150"/>

        <TextBlock Grid.Row="9" Text="Дополнительные примечания:" FontWeight="Bold"/>
        <TextBox Grid.Row="9" x:Name="txtNotes" Margin="0,25,0,20" Height="60" 
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="5"
                 ToolTip="Укажите дополнительные пожелания или особенности"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveOrder" Content="💾 Создать заказ" Click="SaveOrder_Click"
                    Padding="20,10" Margin="5" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="Cancel" Content="❌ Отмена" Click="Cancel_Click"
                    Padding="20,10" Margin="5" Background="#dc3545" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>
