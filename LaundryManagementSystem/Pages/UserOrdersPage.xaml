<Page x:Class="LaundryManagementSystem.Pages.UserOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserOrdersPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Мои заказы" 
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text=" (Режим пользователя)" 
                       Foreground="Blue" FontWeight="Bold" 
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button x:Name="CreateOrder" Content="➕ Создать заказ" Click="CreateOrder_Click"
                    Padding="15,8" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="Refresh" Content="🔄 Обновить" Click="Refresh_Click" 
                    Padding="15,8" Background="#6c757d" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            <Button x:Name="GoToMainPage" Content="🏠 На главную" Click="GoToMainPage_Click" 
                    Padding="15,8" Background="#6f42c1" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Список заказов пользователя -->
        <DataGrid Grid.Row="1" x:Name="dgOrders" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="dgOrders_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderID}" Width="60"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Services.ServiceName}" Width="150"/>
                <DataGridTextColumn Header="Ткань" Binding="{Binding FabricTypes.FabricName}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding OrderStatuses.StatusName}" Width="100">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrderStatuses.StatusName}" Value="готов">
                                    <Setter Property="Foreground" Value="Green"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OrderStatuses.StatusName}" Value="в работе">
                                    <Setter Property="Foreground" Value="Blue"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OrderStatuses.StatusName}" Value="отменен">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Срочный" Binding="{Binding Urgent}" Width="70"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding TotalPrice, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreateDate, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                <DataGridTextColumn Header="Дата завершения" Binding="{Binding CompleteDate, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статистика -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBlock x:Name="txtStats" FontWeight="Bold" Foreground="#555"/>
        </StackPanel>
    </Grid>
</Page>
