<Page x:Class="LaundryManagementSystem.Pages.UsersManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LaundryManagementSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsersManagementPage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Управление пользователями" 
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            
        </StackPanel>
        <TextBlock Text=" (Только для администратора)" 
           Foreground="Red" FontWeight="Bold" 
           Margin="10,20,0,0" VerticalAlignment="Center"/>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button x:Name="AddUser" Content="➕ Новый пользователь" Click="AddUser_Click"
                    Padding="15,8" Background="#28a745" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="Refresh" Content="🔄 Обновить" Click="Refresh_Click" 
                    Padding="15,8" Background="#17a2b8" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            <Button x:Name="GoToMainPage" Content="🏠 На главную" Click="GoToMainPage_Click"
                    Padding="15,8" Background="#6f42c1" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Список пользователей -->
        <DataGrid Grid.Row="1" x:Name="dgUsers" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="dgUsers_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="50"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="Blue"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата регистрации" 
                                    Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                    Width="140"/>
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="EditUser" Content="✏️" Click="EditUser_Click" 
                                        Tag="{Binding UserID}" Margin="2" Padding="8,5"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="Редактировать"/>
                                <Button x:Name="DeleteUser" Content="🗑️" Click="DeleteUser_Click"
                                        Tag="{Binding UserID}" Margin="2" Padding="8,5"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Foreground="Red" ToolTip="Удалить"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
